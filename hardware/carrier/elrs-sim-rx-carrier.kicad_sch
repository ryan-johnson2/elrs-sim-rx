	(text "GP13 to GP9, all unused.\nHoles only, so the module's\nback-row pins have somewhere to go."
		(exclude_from_sim no)
		(at 90.17 101.6 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "f638e8ad-3bd7-5e6a-8c0d-f6e7f0c333ee")
	)
	(text "GP0  UART0 TX, CRSF to receiver\nGP1  UART0 RX, CRSF from receiver, 420000 baud\nGP2  receiver power enable, high = on\nGP3  button, active low, internal pull-up\nGP4  button LED ring, high = on"
		(exclude_from_sim no)
		(at 17.78 127 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "5fd74bb1-f10e-533f-96a4-1a1be248b44a")
	)
	(text "RECEIVER POWER SWITCH"
		(exclude_from_sim no)
		(at 111.76 38.1 0)
		(effects (font (size 1.6 1.6)) (justify left))
		(uuid "6869a998-9e30-5cf4-8e10-f761bc736533")
	)
	(text "TPS22918: 5.5 V, 2 A, 52 mOhm. R1 holds the receiver off until firmware\ndrives GP2. C2 sets the output rise time (roughly 1 to 2 ms at 5 V) to limit\ninrush into C3. QOD tied to VOUT discharges the rail fast on power-off,\nwhich the power-cycle bind sequence relies on."
		(exclude_from_sim no)
		(at 111.76 44.45 0)
		(effects (font (size 1.27 1.27)) (justify left))
		(uuid "7159ee05-911e-5b47-989c-6769689642b9")
	)
